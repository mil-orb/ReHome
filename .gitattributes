# Normalize text to LF in the repo; Windows checkouts convert per core.autocrlf.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.png binary
*.ico binary
*.exe binary
*.dll binary
*.winmd binary

# Lock files are generated. Collapse them in diffs.
package-lock.json linguist-generated=true -diff
packages.lock.json linguist-generated=true -diff
