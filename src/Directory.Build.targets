<Project>

  <!--
    winget's interop files have to sit next to the exe. Inside a single-file bundle,
    WinRT can't find the activation factory and falls back to packaged activation,
    which fails with 0x80073D54 (no package identity).
  -->
  <Target Name="KeepWingetInteropBesideExe" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Management.Deployment'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
