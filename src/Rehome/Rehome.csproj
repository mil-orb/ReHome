<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rehome</AssemblyName>
    <ApplicationIcon>Rehome.ico</ApplicationIcon>
    <RootNamespace>Rehome</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Native code, no .NET runtime to unpack, and nothing an environment variable can load into it when elevated. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="$(WingetInteropVersion)" />
    <ProjectReference Include="..\Rehome.Core\Rehome.Core.csproj" />
    <!-- Imports resolve from System32 only, never from the folder rehome.exe sits in. -->
    <LinkerArg Include="/DEPENDENTLOADFLAG:0x800" />
  </ItemGroup>

  <!--
    winget's metadata and native factory have to sit next to rehome.exe: for an app that isn't packaged, that's the
    only place Windows looks. The desktop app relocates itself to get them there (Portable.cs); the CLI ships them
    beside rehome.exe instead.
  -->
  <Target Name="KeepWingetFilesBesideExe" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'Microsoft.Management.Deployment.winmd'" />
      <ResolvedFileToPublish Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'Microsoft.Management.Deployment.winmd'"
        RelativePath="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
