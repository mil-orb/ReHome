<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ReHome</AssemblyName>
    <ApplicationIcon>Rehome.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Rehome.Shell</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Published with NativeAOT: one native exe with no .NET runtime to unpack, no JIT, and no profiler or
      diagnostics hooks for an environment variable to switch on in the elevated helper. A developer build
      (dotnet build, dotnet run) is still a normal .NET app beside loose DLLs.
    -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <SelfContained>true</SelfContained>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>



  <ItemGroup>
    <!-- Used for its loader only. ReHome talks to WebView2's COM API itself (Native/WebView2.cs). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="$(WingetInteropVersion)" />
    <ProjectReference Include="..\Rehome.Core\Rehome.Core.csproj" />
  </ItemGroup>

  <!--
    The WebView2 package's targets reference its .NET wrapper (Core, WinForms, WPF). That wrapper needs built-in
    COM interop, which NativeAOT doesn't have, and nothing here uses it. Drop the references so nothing can.
  -->
  <Target Name="DropWebView2Wrapper" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Web.WebView2.'))" />
    </ItemGroup>
  </Target>

  <!--
    The WebView2 loader is linked into the published exe from the package's static library, so no DLL sits beside
    it. version.lib is the loader's own dependency. /DEPENDENTLOADFLAG makes Windows resolve the exe's imports
    from System32 only, so a DLL dropped next to the exe (for example a version.dll) is never loaded.
  -->
  <ItemGroup>
    <DirectPInvoke Include="WebView2Loader" />
    <NativeLibrary Include="$(PkgMicrosoft_Web_WebView2)\build\native\x64\WebView2LoaderStatic.lib" />
    <NativeLibrary Include="version.lib" />
    <LinkerArg Include="/DEPENDENTLOADFLAG:0x800" />
  </ItemGroup>

  <!--
    The web UI is built by Vite and compiled into the exe as resources.
    The app serves it from memory, so nothing on disk can swap it out.
  -->
  <PropertyGroup>
    <UiDir>$(MSBuildProjectDirectory)\ui</UiDir>
  </PropertyGroup>

  <ItemGroup>
    <UiSource Include="ui\src\**\*;ui\index.html;ui\package-lock.json;ui\vite.config.ts;ui\tsconfig.json" />
  </ItemGroup>

  <Target Name="InstallUi" BeforeTargets="BuildUi" Condition="!Exists('$(UiDir)\node_modules')">
    <!-- Lock-file versions only, and no package install scripts. Same command as CI. -->
    <Exec Command="npm ci --ignore-scripts --no-fund --no-audit" WorkingDirectory="$(UiDir)" />
  </Target>

  <Target Name="BuildUi" BeforeTargets="BeforeBuild" Inputs="@(UiSource)" Outputs="$(UiDir)\dist\index.html">
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)" />
  </Target>

  <Target Name="EmbedUi" AfterTargets="BuildUi" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_UiFile Include="ui\dist\**\*" />
      <EmbeddedResource Include="@(_UiFile)" LogicalName="ui/$([System.String]::Copy('%(_UiFile.RecursiveDir)').Replace('\', '/'))%(_UiFile.Filename)%(_UiFile.Extension)" />
    </ItemGroup>
  </Target>

  <!--
    winget's API needs two files in the folder of the running exe: Microsoft.Management.Deployment.winmd, which
    WinRT reads to marshal calls to winget's out-of-process server, and Microsoft.Management.Deployment.dll, the
    small native factory that starts it. For an unpackaged app Windows only looks beside the exe. Both are embedded
    instead of published, and Portable.cs writes them beside a private copy of the exe at first run, so the
    published app is one file.
  -->
  <Target Name="EmbedWingetFiles" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'Microsoft.Management.Deployment.winmd' or '%(Filename)%(Extension)' == 'Microsoft.Management.Deployment.dll'" LogicalName="%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <Target Name="PublishOneFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'Microsoft.Management.Deployment.winmd' or '%(Filename)%(Extension)' == 'Microsoft.Management.Deployment.dll'" />
      <!-- A developer build loads WebView2Loader.dll from beside it. The published exe has the loader linked in. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'WebView2Loader.dll'" />
    </ItemGroup>
  </Target>

</Project>
