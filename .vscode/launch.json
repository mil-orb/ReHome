{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rehome (desktop app)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Rehome.App/bin/Debug/net10.0-windows10.0.26100.0/win-x64/ReHome.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      "name": "rehome scan (CLI, read-only)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Rehome/bin/Debug/net10.0-windows10.0.26100.0/win-x64/rehome.exe",
      "args": ["scan"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
